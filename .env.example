# Copy this file to .env.local and fill in your own project values.

# Required — Supabase project URL and publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional — enables notification emails and cross-user lookups on the server.
# Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Brevo transactional email.
BREVO_API_KEY=sampleAPIKey
BREVO_SENDER_EMAIL=hello@example.com
BREVO_SENDER_NAME=ChingChingGift

# Used for links inside emails. Set this to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
